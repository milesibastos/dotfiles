#!/usr/bin/env bash

# Merging requires human approval: block `gh pr merge` and the REST merge endpoint.
prev=""
for arg in "$@"; do
  if [[ "$prev" == "pr" && "$arg" == "merge" ]] ||
     [[ "$1" == "api" && "$arg" == *pulls/*/merge* ]]; then
    echo "🚫 Blocked: merging requires human approval."
    exit 1
  fi
  prev="$arg"
done

# Exec the real gh directly; fall back to brew --prefix only when not found
for real_gh in /opt/homebrew/bin/gh /usr/local/bin/gh /home/linuxbrew/.linuxbrew/bin/gh; do
  [[ -x "$real_gh" ]] && exec "$real_gh" "$@"
done
exec "$(brew --prefix)/bin/gh" "$@"
