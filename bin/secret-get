#!/usr/bin/env bash
# Drop-in replacement for `pass show` that works from a session with no
# terminal: unlocks the gpg-agent cache first (see pass-unlock), then prints
# the entry on stdout.
#
# The secret goes to stdout, so always consume it in the same command — pipe
# it into the tool that needs it, never capture it into a log or a transcript:
#
#     secret-get personal/github | gh auth login --with-token
#     some-tool --credential-file <(secret-get NAME)
#
# Entries under a passphrase-less subtree (agent/) never prompt at all; for
# those this is just `pass show` with an extra existence check.

set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
Usage: $command_name [options] ENTRY

Print a pass entry on stdout, unlocking the gpg-agent cache first if needed.

Options:
    -t, --timeout SECONDS   Passed through to pass-unlock
    -h, --help              Show this help message
EOF
}

die() {
  printf '%s: %s\n' "$command_name" "$1" >&2
  exit "${2:-1}"
}

main() {
  local -a unlock_args=()
  while (($#)); do
    case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -t | --timeout)
      (($# >= 2)) || die "--timeout needs a value" 2
      unlock_args+=(--timeout "$2")
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*) die "unknown option: $1" 2 ;;
    *) break ;;
    esac
  done

  (($# == 1)) || {
    usage >&2
    exit 2
  }

  # Unlock chatter goes to stderr so stdout carries nothing but the secret.
  # The `[@]+` guard keeps an empty array from tripping `set -u` on bash 3.2,
  # which is what /usr/bin/env finds on macOS.
  "$script_dir/pass-unlock" ${unlock_args[@]+"${unlock_args[@]}"} "$1" >&2
  exec pass show "$1"
}

main "$@"
