#!/usr/bin/env bash

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
DIM='\033[2m'
RESET='\033[0m'

# Separator (minimal style)
SEP="${DIM}│${RESET}"

# Nerd font icons (colorized). Glyphs are embedded literally because macOS's
# system bash 3.2 doesn't expand \u/\U escapes in printf.
ICON_PROJECT="${BLUE}${RESET}"     # \ue5ff
ICON_BRANCH="${GREEN}${RESET}"     # \ue725
ICON_CONTEXT="${MAGENTA}󰧑${RESET}"  # \U000f09d1
ICON_COST="${GREEN}${RESET}"       # \uf155
ICON_STYLE="${CYAN}󰏘${RESET}"       # \U000f03d8
ICON_LINES="${CYAN}${RESET}"       # \uf440
ICON_AGENT="${DIM}󰚩${RESET}"        # \U000f06a9
ICON_SESSION="${DIM}${RESET}"     # \uf292

# Feature flags
SHOW_CONTEXT_TOKENS="${CLAUDE_STATUSLINE_TOKENS:-1}"  # 0 hides the (used/total) suffix
SHOW_SESSION_FULL="${CLAUDE_STATUSLINE_SESSION_FULL:-0}"  # 1 shows the full session UUID
PATH_MAX="${CLAUDE_STATUSLINE_PATH_MAX:-}"  # fixed path budget; empty = derive from terminal width
PATH_TAIL="${CLAUDE_STATUSLINE_PATH_TAIL:-3}"  # trailing dirs that always keep their full name

# Read JSON input from stdin
input=$(cat)

# Helper functions for extracting data
get_model_name() { echo "$input" | jq -r '.model.display_name // "Unknown Model"' | sed 's/ (.*)//'; }

# Get model-specific icon based on model name
get_model_icon() {
  local model_name=$(get_model_name)
  case "$model_name" in
  *[Oo]pus*) printf "${MAGENTA}󰇥${RESET}" ;;   # \U000f01e5
  *[Ss]onnet*) printf "${CYAN}󰝚${RESET}" ;;    # \U000f075a
  *[Hh]aiku*) printf "${GREEN}󰜵${RESET}" ;;    # \U000f0735
  *) printf "${DIM}󰚩${RESET}" ;;               # \U000f06a9
  esac
}
get_output_style() { echo "$input" | jq -r '.output_style.name // "default"'; }
get_current_dir() { echo "$input" | jq -r '.workspace.current_dir // .cwd // "."'; }
get_cost() {
  local cost=$(echo "$input" | jq -r '.cost.total_cost_usd // 0')
  local formatted
  formatted=$(printf "%.2f" "$cost" 2>/dev/null) || return
  [ "$formatted" = "0.00" ] && return
  printf "${DIM}\$%s${RESET}" "$formatted"
}

get_lines_changed() {
  local added=$(echo "$input" | jq -r '.cost.total_lines_added // 0')
  local removed=$(echo "$input" | jq -r '.cost.total_lines_removed // 0')
  [ "$added" = "0" ] && [ "$removed" = "0" ] && return
  printf "${GREEN}+%d${RESET}/${RED}-%d${RESET}" "$added" "$removed"
}

get_agent_name() {
  echo "$input" | jq -r '.agent.name // empty'
}

# Session id — short prefix by default, full UUID when the flag is set
get_session_id() {
  local id
  id=$(echo "$input" | jq -r '.session_id // empty')
  [ -n "$id" ] || return
  if [ "$SHOW_SESSION_FULL" = "1" ]; then
    printf "%s" "$id"
  else
    printf "%s" "${id:0:8}"
  fi
}

# Compact token count: 850 → 850, 123456 → 123K, 1000000 → 1M
format_tokens() {
  local n="$1"
  if [ "$n" -ge 1000000 ]; then
    local whole=$((n / 1000000))
    local frac=$(((n % 1000000) / 100000))
    if [ "$frac" -gt 0 ]; then
      printf "%d.%dM" "$whole" "$frac"
    else
      printf "%dM" "$whole"
    fi
  elif [ "$n" -ge 1000 ]; then
    printf "%dK" $((n / 1000))
  else
    printf "%d" "$n"
  fi
}

# Replace a leading $HOME with ~. Done with prefix stripping rather than
# ${var/#$HOME/~} because bash tilde-expands the replacement, turning that
# substitution into a silent no-op. The trailing slash in the second pattern
# keeps /Users/etereo2 from matching /Users/etereo.
contract_home() {
  [ -n "$HOME" ] || {
    printf '%s' "$1"
    return
  }
  case "$1" in
  "$HOME") printf '~' ;;
  "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
  *) printf '%s' "$1" ;;
  esac
}

# Shrink a path to fit $2 columns by collapsing leading directories to their
# initial, left to right, until it fits. The last $3 components always keep
# their full name, so an over-budget path degrades instead of losing the part
# that identifies it:
#   ~/workspaces/billin/workspace/stories/BO-14194-ficha-contactos-v2/code/gofre
#   → ~/w/b/w/s/BO-14194-ficha-contactos-v2/code/gofre
shorten_path() {
  local path="$1" budget="$2" keep="$3"

  [ "${#path}" -le "$budget" ] && {
    printf '%s' "$path"
    return
  }

  # Hold the root slash aside; a leading delimiter would otherwise split into
  # an empty first field and yield a doubled slash.
  local lead=""
  case "$path" in
  /*)
    lead="/"
    path="${path#/}"
    ;;
  esac

  # Split on / with globbing off, so a component like * stays literal.
  local oldifs="$IFS" parts
  set -f
  IFS='/'
  # shellcheck disable=SC2206  # splitting is the point; globbing is off, and
  # mapfile/readarray don't exist in the bash 3.2 that ships with macOS
  parts=($path)
  set +f
  IFS="$oldifs"

  local n="${#parts[@]}"
  [ "$n" -le 1 ] && {
    printf '%s' "$path"
    return
  }

  # Never abbreviate past this index — the protected tail
  local floor=$((n - keep))
  [ "$floor" -lt 1 ] && floor=1

  local i j c result=""
  for ((i = 0; i <= floor; i++)); do
    result="$lead"
    for ((j = 0; j < n; j++)); do
      [ "$j" -gt 0 ] && result="$result/"
      if [ "$j" -lt "$i" ]; then
        c="${parts[j]}"
        case "$c" in
        .?*) result="$result${c:0:2}" ;; # keep dotdirs distinguishable: .config → .c
        *) result="$result${c:0:1}" ;;
        esac
      else
        result="$result${parts[j]}"
      fi
    done
    [ "${#result}" -le "$budget" ] && break
  done

  printf '%s' "$result"
}

# Context remaining, e.g. "87% (123K/1M)" — color-coded on the percentage
build_context_display() {
  # Pre-calculated by Claude Code; null until the first API response
  local remaining used window
  remaining=$(echo "$input" | jq -r '.context_window.remaining_percentage // 100')
  used=$(echo "$input" | jq -r '.context_window.total_input_tokens // 0')
  window=$(echo "$input" | jq -r '.context_window.context_window_size // 200000')

  remaining=$(printf "%.0f" "$remaining" 2>/dev/null) || remaining=100
  used=$(printf "%.0f" "$used" 2>/dev/null) || used=0
  window=$(printf "%.0f" "$window" 2>/dev/null) || window=200000

  [ "$remaining" -gt 100 ] && remaining=100
  [ "$remaining" -lt 0 ] && remaining=0

  local color
  if [ "$remaining" -gt 50 ]; then
    color="$GREEN"
  elif [ "$remaining" -gt 20 ]; then
    color="$YELLOW"
  else
    color="$RED"
  fi

  if [ "$SHOW_CONTEXT_TOKENS" = "1" ]; then
    printf "%s%d%%${RESET} ${DIM}(%s/%s)${RESET}" \
      "$color" "$remaining" "$(format_tokens "$used")" "$(format_tokens "$window")"
  else
    printf "%s%d%%${RESET}" "$color" "$remaining"
  fi
}

# Extract values
model=$(get_model_name)
model_icon=$(get_model_icon)
output_style=$(get_output_style)
current_dir=$(get_current_dir)
cost_display=$(get_cost)
context_display=$(build_context_display)
lines_display=$(get_lines_changed)
agent_name=$(get_agent_name)
session_id=$(get_session_id)

# Get git branch
git_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "no-git")

# Terminal width for adaptive display (tmux pane-aware)
if [ -n "$TMUX" ]; then
  term_width=$(tmux display-message -p '#{pane_width}' 2>/dev/null || echo 200)
else
  term_width="${COLUMNS:-$(tput cols 2>/dev/null || echo 200)}"
fi

# Contract $HOME to ~, then fit the path into roughly a third of the line
path_budget="$PATH_MAX"
if [ -z "$path_budget" ]; then
  path_budget=$((term_width / 3))
  [ "$path_budget" -lt 24 ] && path_budget=24
  [ "$path_budget" -gt 60 ] && path_budget=60
fi
display_dir=$(shorten_path "$(contract_home "$current_dir")" "$path_budget" "$PATH_TAIL")

# Build segments — order: identity → impact → resources → meta
seg_add() {
  if [ -n "$statusline" ]; then
    statusline+=" ${SEP} "
  fi
  statusline+="$1"
}

statusline=""

# ── Identity (only show model if not Opus) ──
if [[ "$model" != *[Oo]pus* ]]; then
  statusline+="${model_icon} ${MAGENTA}${model}${RESET}"
fi
if [ -n "$agent_name" ]; then
  statusline+=" ${DIM}(${agent_name})${RESET}"
fi

# ── Session impact ──
if [ -n "$cost_display" ]; then
  seg_add "${ICON_COST} ${cost_display}"
fi
if [ -n "$lines_display" ]; then
  seg_add "${ICON_LINES} ${lines_display}"
fi

# ── Resource gauges ──
seg_add "${ICON_CONTEXT} ${context_display}"

# ── Meta (collapsible) ──
if [ "$term_width" -gt 160 ] && [ "$output_style" != "default" ]; then
  seg_add "${ICON_STYLE} ${DIM}${output_style}${RESET}"
fi
if [ -n "$session_id" ]; then
  seg_add "${ICON_SESSION} ${DIM}${session_id}${RESET}"
fi

# Prepend branch on wide terminals
if [ "$term_width" -gt 120 ]; then
  statusline="${ICON_BRANCH} ${GREEN}${git_branch}${RESET} ${SEP} ${statusline}"
fi

# Prepend the current path
statusline="${ICON_PROJECT} ${BLUE}${display_dir}${RESET} ${SEP} ${statusline}"

echo -e "$statusline"
